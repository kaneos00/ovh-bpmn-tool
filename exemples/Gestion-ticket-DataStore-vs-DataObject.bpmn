<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Definitions_Ticket" targetNamespace="https://example.org/bpmn/ticket">
 <bpmn:process id="Process_Ticket" name="Gestion d'un ticket" isExecutable="false">
  <bpmn:laneSet id="LaneSet_1">
   <bpmn:lane id="Lane_Demandeur" name="Demandeur">
    <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Creer</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Completer</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Service" name="Service en charge">
    <bpmn:flowNodeRef>Task_Analyser</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Complet</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Demander</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Traiter</bpmn:flowNodeRef>
   </bpmn:lane>
   <bpmn:lane id="Lane_Validateur" name="Validateur">
    <bpmn:flowNodeRef>Task_Valider</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Valide</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Reprendre</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Clore</bpmn:flowNodeRef><bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
   </bpmn:lane>
  </bpmn:laneSet>
  <bpmn:startEvent id="Start_1" name="Besoin identifié"/>
  <bpmn:task id="Task_Creer" name="Créer le ticket"/>
  <bpmn:task id="Task_Analyser" name="Analyser la demande"/>
  <bpmn:exclusiveGateway id="Gateway_Complet" name="Informations suffisantes ?"/>
  <bpmn:task id="Task_Demander" name="Demander des informations"/>
  <bpmn:task id="Task_Completer" name="Compléter le ticket"/>
  <bpmn:task id="Task_Traiter" name="Traiter la demande"/>
  <bpmn:task id="Task_Valider" name="Valider le traitement"/>
  <bpmn:exclusiveGateway id="Gateway_Valide" name="Traitement validé ?"/>
  <bpmn:task id="Task_Reprendre" name="Reprendre le traitement"/>
  <bpmn:task id="Task_Clore" name="Clore le ticket"/>
  <bpmn:endEvent id="End_1" name="Ticket clôturé"/>
  <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_Creer"/>
  <bpmn:sequenceFlow id="F2" sourceRef="Task_Creer" targetRef="Task_Analyser"/>
  <bpmn:sequenceFlow id="F3" sourceRef="Task_Analyser" targetRef="Gateway_Complet"/>
  <bpmn:sequenceFlow id="F4" name="Non" sourceRef="Gateway_Complet" targetRef="Task_Demander"/>
  <bpmn:sequenceFlow id="F5" sourceRef="Task_Demander" targetRef="Task_Completer"/>
  <bpmn:sequenceFlow id="F6" sourceRef="Task_Completer" targetRef="Task_Analyser"/>
  <bpmn:sequenceFlow id="F7" name="Oui" sourceRef="Gateway_Complet" targetRef="Task_Traiter"/>
  <bpmn:sequenceFlow id="F8" sourceRef="Task_Traiter" targetRef="Task_Valider"/>
  <bpmn:sequenceFlow id="F9" sourceRef="Task_Valider" targetRef="Gateway_Valide"/>
  <bpmn:sequenceFlow id="F10" name="Non" sourceRef="Gateway_Valide" targetRef="Task_Reprendre"/>
  <bpmn:sequenceFlow id="F11" sourceRef="Task_Reprendre" targetRef="Task_Traiter"/>
  <bpmn:sequenceFlow id="F12" name="Oui" sourceRef="Gateway_Valide" targetRef="Task_Clore"/>
  <bpmn:sequenceFlow id="F13" sourceRef="Task_Clore" targetRef="End_1"/>
  <bpmn:dataObject id="Ticket_Data" name="Ticket"/>
  <bpmn:dataObjectReference id="Ticket_Ref" dataObjectRef="Ticket_Data" name="Ticket (données, statut, historique)"/>
  <bpmn:dataStore id="Ticket_Tool" name="Outil de gestion des tickets"/>
  <bpmn:dataStoreReference id="Ticket_Tool_Ref" dataStoreRef="Ticket_Tool" name="Outil de gestion des tickets"/>
  <bpmn:dataOutputAssociation id="TicketCreated" name="Créer / enregistrer">
   <bpmn:sourceRef>Task_Creer</bpmn:sourceRef><bpmn:targetRef>Ticket_Ref</bpmn:targetRef>
  </bpmn:dataOutputAssociation>
  <bpmn:dataInputAssociation id="TicketReadAnalysis">
   <bpmn:sourceRef>Ticket_Ref</bpmn:sourceRef><bpmn:targetRef>Task_Analyser</bpmn:targetRef>
  </bpmn:dataInputAssociation>
  <bpmn:dataOutputAssociation id="TicketUpdated">
   <bpmn:sourceRef>Task_Traiter</bpmn:sourceRef><bpmn:targetRef>Ticket_Ref</bpmn:targetRef>
  </bpmn:dataOutputAssociation>
  <bpmn:dataOutputAssociation id="TicketClosed">
   <bpmn:sourceRef>Task_Clore</bpmn:sourceRef><bpmn:targetRef>Ticket_Ref</bpmn:targetRef>
  </bpmn:dataOutputAssociation>
  <bpmn:association id="StoreFromCreate" sourceRef="Task_Creer" targetRef="Ticket_Tool_Ref" associationDirection="One"/>
  <bpmn:association id="StoreForAnalysis" sourceRef="Task_Analyser" targetRef="Ticket_Tool_Ref" associationDirection="One"/>
  <bpmn:association id="StoreForTreatment" sourceRef="Task_Traiter" targetRef="Ticket_Tool_Ref" associationDirection="One"/>
  <bpmn:association id="StoreForClose" sourceRef="Task_Clore" targetRef="Ticket_Tool_Ref" associationDirection="One"/>
  <bpmn:textAnnotation id="Note_Ticket"><bpmn:text>Objet de données : l'information métier manipulée (identifiant, demande, statut, échanges et historique).</bpmn:text></bpmn:textAnnotation>
  <bpmn:association id="NoteTicketLink" sourceRef="Ticket_Ref" targetRef="Note_Ticket"/>
  <bpmn:textAnnotation id="Note_Tool"><bpmn:text>Data Store : le système persistant où les tickets sont conservés. Un seul magasin de données peut être partagé par plusieurs tâches.</bpmn:text></bpmn:textAnnotation>
  <bpmn:association id="NoteToolLink" sourceRef="Ticket_Tool_Ref" targetRef="Note_Tool"/>
 </bpmn:process>
 <bpmndi:BPMNDiagram id="Diagram_1"><bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_Ticket">
  <bpmndi:BPMNShape id="Lane_Demandeur_di" bpmnElement="Lane_Demandeur" isHorizontal="true"><dc:Bounds x="80" y="80" width="1500" height="140"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Lane_Service_di" bpmnElement="Lane_Service" isHorizontal="true"><dc:Bounds x="80" y="220" width="1500" height="170"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Lane_Validateur_di" bpmnElement="Lane_Validateur" isHorizontal="true"><dc:Bounds x="80" y="390" width="1500" height="140"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"><dc:Bounds x="120" y="132" width="36" height="36"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Task_Creer_di" bpmnElement="Task_Creer"><dc:Bounds x="190" y="115" width="120" height="70"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Task_Analyser_di" bpmnElement="Task_Analyser"><dc:Bounds x="380" y="265" width="140" height="70"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Gateway_Complet_di" bpmnElement="Gateway_Complet" isMarkerVisible="true"><dc:Bounds x="570" y="275" width="50" height="50"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Task_Demander_di" bpmnElement="Task_Demander"><dc:Bounds x="660" y="230" width="150" height="70"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Task_Completer_di" bpmnElement="Task_Completer"><dc:Bounds x="850" y="115" width="140" height="70"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Task_Traiter_di" bpmnElement="Task_Traiter"><dc:Bounds x="680" y="315" width="130" height="60"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Task_Valider_di" bpmnElement="Task_Valider"><dc:Bounds x="880" y="425" width="130" height="65"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Gateway_Valide_di" bpmnElement="Gateway_Valide" isMarkerVisible="true"><dc:Bounds x="1060" y="432" width="50" height="50"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Task_Reprendre_di" bpmnElement="Task_Reprendre"><dc:Bounds x="1160" y="405" width="145" height="65"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Task_Clore_di" bpmnElement="Task_Clore"><dc:Bounds x="1360" y="425" width="120" height="65"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1"><dc:Bounds x="1510" y="440" width="36" height="36"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Ticket_Ref_di" bpmnElement="Ticket_Ref"><dc:Bounds x="360" y="105" width="36" height="50"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Ticket_Tool_Ref_di" bpmnElement="Ticket_Tool_Ref"><dc:Bounds x="1060" y="105" width="50" height="50"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Note_Ticket_di" bpmnElement="Note_Ticket"><dc:Bounds x="430" y="80" width="270" height="65"/></bpmndi:BPMNShape>
  <bpmndi:BPMNShape id="Note_Tool_di" bpmnElement="Note_Tool"><dc:Bounds x="1140" y="80" width="370" height="70"/></bpmndi:BPMNShape>
  <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="156" y="150"/><di:waypoint x="190" y="150"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="310" y="150"/><di:waypoint x="345" y="150"/><di:waypoint x="345" y="300"/><di:waypoint x="380" y="300"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="520" y="300"/><di:waypoint x="570" y="300"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="595" y="275"/><di:waypoint x="595" y="265"/><di:waypoint x="660" y="265"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="735" y="230"/><di:waypoint x="735" y="150"/><di:waypoint x="850" y="150"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="920" y="185"/><di:waypoint x="920" y="205"/><di:waypoint x="450" y="205"/><di:waypoint x="450" y="265"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="620" y="300"/><di:waypoint x="680" y="345"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="810" y="345"/><di:waypoint x="845" y="345"/><di:waypoint x="845" y="457"/><di:waypoint x="880" y="457"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1010" y="457"/><di:waypoint x="1060" y="457"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1110" y="457"/><di:waypoint x="1160" y="437"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1232" y="405"/><di:waypoint x="1232" y="380"/><di:waypoint x="745" y="380"/><di:waypoint x="745" y="375"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1110" y="457"/><di:waypoint x="1360" y="457"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1480" y="457"/><di:waypoint x="1510" y="458"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="TicketCreated_di" bpmnElement="TicketCreated"><di:waypoint x="250" y="185"/><di:waypoint x="378" y="155"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="TicketReadAnalysis_di" bpmnElement="TicketReadAnalysis"><di:waypoint x="378" y="155"/><di:waypoint x="450" y="265"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="TicketUpdated_di" bpmnElement="TicketUpdated"><di:waypoint x="745" y="375"/><di:waypoint x="396" y="155"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="TicketClosed_di" bpmnElement="TicketClosed"><di:waypoint x="1420" y="425"/><di:waypoint x="396" y="155"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="StoreFromCreate_di" bpmnElement="StoreFromCreate"><di:waypoint x="310" y="150"/><di:waypoint x="1060" y="130"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="StoreForAnalysis_di" bpmnElement="StoreForAnalysis"><di:waypoint x="520" y="300"/><di:waypoint x="1085" y="155"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="StoreForTreatment_di" bpmnElement="StoreForTreatment"><di:waypoint x="810" y="345"/><di:waypoint x="1085" y="155"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="StoreForClose_di" bpmnElement="StoreForClose"><di:waypoint x="1420" y="425"/><di:waypoint x="1085" y="155"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="NoteTicketLink_di" bpmnElement="NoteTicketLink"><di:waypoint x="396" y="130"/><di:waypoint x="430" y="112"/></bpmndi:BPMNEdge>
  <bpmndi:BPMNEdge id="NoteToolLink_di" bpmnElement="NoteToolLink"><di:waypoint x="1110" y="130"/><di:waypoint x="1140" y="112"/></bpmndi:BPMNEdge>
 </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>