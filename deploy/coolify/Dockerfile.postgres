FROM postgres:16-alpine
COPY backend/migrations/init.sql /docker-entrypoint-initdb.d/00-init.sql
COPY backend/migrations/20261011_v2_project_context.sql /docker-entrypoint-initdb.d/10-v2-project-context.sql
COPY backend/migrations/20261011_v2_project_raci.sql /docker-entrypoint-initdb.d/20-v2-project-raci.sql
COPY backend/migrations/20261012_v2_project_raci_actors.sql /docker-entrypoint-initdb.d/30-v2-project-raci-actors.sql
COPY deploy/coolify/db/40-seed-demo.sh /docker-entrypoint-initdb.d/40-seed-demo.sh
COPY deploy/coolify/db/seed-demo.sql /opt/seed-demo.sql
RUN chmod 0755 /docker-entrypoint-initdb.d/40-seed-demo.sh
