FROM node:24-alpine AS build
WORKDIR /app
RUN corepack enable
COPY backend/package.json backend/pnpm-lock.yaml backend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY backend/ ./
RUN pnpm build
RUN pnpm prune --prod

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY backend/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
# The seed reads its BPMN fixture relative to the compiled script.
# Keep the fixture in the runtime image so it can be run from Coolify's terminal.
COPY --from=build /app/src/seeds/fixtures ./dist/seeds/fixtures
USER node
EXPOSE 3000
CMD ["node", "dist/main"]
