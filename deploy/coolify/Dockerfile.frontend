FROM node:24-alpine AS build
WORKDIR /app
RUN corepack enable
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
ARG VITE_API_URL=/bpmn-api
ARG VITE_APP_BASE_PATH=/
ARG VITE_BUILD_ID=unknown
ARG VITE_BUILD_RUN_NUMBER=unknown
ARG VITE_BUILD_COMMIT=unknown
ARG VITE_BUILD_BRANCH=unknown
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_APP_BASE_PATH=${VITE_APP_BASE_PATH}
ENV VITE_BUILD_ID=${VITE_BUILD_ID}
ENV VITE_BUILD_RUN_NUMBER=${VITE_BUILD_RUN_NUMBER}
ENV VITE_BUILD_COMMIT=${VITE_BUILD_COMMIT}
ENV VITE_BUILD_BRANCH=${VITE_BUILD_BRANCH}
# When Coolify does not provide Git metadata, derive a reproducible identifier
# from the exact frontend source and dependency manifests in this image build.
RUN set -eu; \
    SOURCE_HASH="$( { find src dev -type f -print0 | sort -z | xargs -0 sha256sum; sha256sum package.json pnpm-lock.yaml pnpm-workspace.yaml; } | sha256sum | cut -c1-12)"; \
    if [ "$VITE_BUILD_ID" = "unknown" ]; then \
      if [ "$VITE_BUILD_COMMIT" != "unknown" ]; then VITE_BUILD_ID="$VITE_BUILD_COMMIT"; \
      else VITE_BUILD_ID="src-$SOURCE_HASH"; fi; \
    fi; \
    export VITE_BUILD_ID; \
    pnpm build

FROM nginx:1.28-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/coolify/nginx.conf.template /etc/nginx/templates/default.conf.template
EXPOSE 80
